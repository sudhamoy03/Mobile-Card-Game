# Server Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Heartbeat and Reconnection
PING_INTERVAL_MS=10000
PING_TIMEOUT_MS=5000
RECONNECT_WINDOW_SECONDS=30

# Firebase Admin Configuration
# Option 1: Path to service account JSON key file
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# Option 2: Individual variables
FIREBASE_PROJECT_ID=card-game-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@card-game-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://card-game-project-default-rtdb.firebaseio.com

# Auth Mode: "firebase" (enforces Firebase ID token) or "dev" (permits dev tokens)
AUTH_MODE=dev
